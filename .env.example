# Copia este archivo como ".env" y coloca tus propios valores.

# Puerto en el que correra la API
PORT=3000

# Datos de conexion a tu MySQL (los mismos que usa ImportamanApp en ConexionDB.java,
# solo que aqui separados campo por campo en vez de una sola URL JDBC)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=importamanoficial

# Origen permitido para CORS: la URL donde corre tu app de React (Vite)
FRONTEND_URL=http://localhost:5173
